# ccmobile Configuration
# Copy this file to .env and fill in your values
# Or skip this — run `npm start` and configure from the browser setup wizard

# Server port (default: 6767)
# PORT=6767

# Optional access key — if set, users must enter it to use the app
# Leave empty or remove for local/trusted network use (no login required)
# CCMOBILE_ACCESS_KEY=your-secret-key-here

# Root directory containing your projects
# Each subdirectory becomes a selectable project in the UI
# CCMOBILE_PROJECT_ROOT=/home/youruser/projects

# Home directory — used to locate ~/.claude/ sessions and file history
# Defaults to current OS user's home directory
# CCMOBILE_HOME_DIR=/home/youruser

# Path to Claude CLI binary (auto-detected if not set)
# CCMOBILE_CLAUDE_CLI=/usr/bin/claude

# CLI Backend: claude (default) | codex
# Determines which coding agent CLI to use
# CCMOBILE_CLI_BACKEND=claude

# Path to Codex CLI binary (auto-detected if not set)
# CCMOBILE_CODEX_CLI=/usr/local/bin/codex

# Default Codex model (default: o3)
# CCMOBILE_CODEX_MODEL=gpt-5.5

# Sandbox mode: auto (default) | true | false
# auto = use bwrap if available, skip if not
# true = require bwrap (fail if missing)
# false = always run Claude directly without sandbox
# CCMOBILE_SANDBOX=auto

# Path to bwrap binary (auto-detected if not set)
# CCMOBILE_BWRAP_PATH=/usr/bin/bwrap
